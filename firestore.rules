rules_version = '2';
// Gift Tags security rules. Tested by tests/rules/*.test.js (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(hid) { return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)); }
    function invite(code) { return get(/databases/$(database)/documents/invites/$(code)).data; }
    // the person on the list that the signed-in member is
    function myPerson(hid) { return get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.personId; }

    match /households/{hid} {
      allow read: if member(hid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if member(hid) && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;

      // Shared lists: anyone in the household
      match /{list}/{id} {
        allow read, write: if list in ['people', 'occasions', 'gifts', 'tombstones'] && member(hid);
      }

      // Gifts someone else is buying for a person on the list: everyone except that person
      match /surprises/{pid}/gifts/{id} {
        allow read, write: if member(hid) && myPerson(hid) != pid;
      }

      // Each member's own wish list: which list is theirs (the list itself lives in /wishlists, so a link
      // can reach it without membership). Only you can point your person at a list you own.
      match /wishlists/{pid} {
        allow read: if member(hid);
        allow create, update: if member(hid) && myPerson(hid) == pid
          && request.resource.data.owner == request.auth.uid && request.resource.data.listId is string;
        allow delete: if member(hid) && myPerson(hid) == pid;
      }

      match /members/{uid} {
        allow read: if member(hid);
        // You may add only yourself: as the household's creator (in the same batch that creates it),
        // or with a live invite to this household, as the person the invite was made for.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.personId is string && request.resource.data.personId.size() > 0 && (
          // creating the household: only in the same write that creates it (not by leaving and coming back)
          (!exists(/databases/$(database)/documents/households/$(hid))
            && getAfter(/databases/$(database)/documents/households/$(hid)).data.createdBy == uid)
          // joining: someone else's live invite, as its person, used up in this same write
          || (request.resource.data.invite is string
              && invite(request.resource.data.invite).hid == hid
              && invite(request.resource.data.invite).personId == request.resource.data.personId
              && invite(request.resource.data.invite).createdBy != uid
              && invite(request.resource.data.invite).expires > request.time
              && !existsAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite))));
        // who you are never changes (or you could become someone else and read their surprises)
        allow update: if member(hid) && request.resource.data.personId == resource.data.personId;
        allow delete: if request.auth.uid == uid || member(hid);   // leave, or remove someone
      }
    }

    // Invites are read one at a time by their code; they can't be listed.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if member(request.resource.data.hid) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expires is timestamp && code.size() >= 20
        && request.resource.data.personId is string && request.resource.data.personId.size() > 0;
      // members can cancel invites; the person joining deletes it as part of joining
      allow delete: if signedIn() && existsAfter(/databases/$(database)/documents/households/$(resource.data.hid)/members/$(request.auth.uid));
      allow update: if false;
    }

    // Wish lists. The id is the share link's secret (20+ characters): a list is fetched by id, never listed.
    // Anyone signed in (the share page signs in anonymously) can read one; only its owner changes it.
    match /wishlists/{lid} {
      function wl() { return get(/databases/$(database)/documents/wishlists/$(lid)).data; }
      function wellFormed(d) {
        return d.keys().hasOnly(['owner', 'hid', 'personId', 'name', 'items', 'updated'])
          && d.items is list && d.items.size() <= 200 && d.name is string && d.name.size() <= 100;
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && lid.size() >= 20 && wellFormed(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && myPerson(request.resource.data.hid) == request.resource.data.personId;
      allow update: if signedIn() && resource.data.owner == request.auth.uid && wellFormed(request.resource.data)
        && request.resource.data.owner == resource.data.owner && request.resource.data.hid == resource.data.hid
        && request.resource.data.personId == resource.data.personId;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // Who's getting which wish (doc id = the wish's id). Hidden from the list's owner, always.
      // A claim is made as yourself and only you can take it back; the owner can clear claims (when deleting
      // a wish or the list) without being able to read them.
      match /claims/{item} {
        allow read: if signedIn() && wl().owner != request.auth.uid;
        allow create: if signedIn() && wl().owner != request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'at', 'person', 'name', 'gift'])
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60));
        allow delete: if signedIn() && (wl().owner == request.auth.uid || resource == null || resource.data.uid == request.auth.uid);
        allow update: if false;
      }
    }

    // Which household an account belongs to, so signing in on a new device finds it.
    // Only you can read yours, and it can only point at a household you're a member of.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.hid is string
        && existsAfter(/databases/$(database)/documents/households/$(request.resource.data.hid)/members/$(uid));
    }

    // Error reports from the app. Anyone signed in can add one (as themselves, small, fixed fields);
    // nobody can read, change or delete them except the project owner in the Firebase console.
    match /errors/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'message', 'stack', 'where', 'version', 'ua', 'page', 'at'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 3000
        && request.resource.data.where is string && request.resource.data.where.size() <= 200
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && request.resource.data.page is string && request.resource.data.page.size() <= 100;
      allow read, update, delete: if false;
    }

    // Phase 0 sign-in test page: each person's own test area only.
    match /spike/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
