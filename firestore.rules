rules_version = '2';
// Gift Tags security rules. Tested by tests/rules/*.test.js (npm run test:rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(hid) { return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)); }
    function invite(code) { return get(/databases/$(database)/documents/invites/$(code)).data; }
    // the person on the list that the signed-in member is
    function myPerson(hid) { return get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.personId; }

    match /households/{hid} {
      allow read: if member(hid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if member(hid) && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;

      // Shared lists: anyone in the household
      match /{list}/{id} {
        allow read, write: if list in ['people', 'occasions', 'gifts', 'tombstones'] && member(hid);
      }

      // Gifts someone else is buying for a person on the list: everyone except that person
      match /surprises/{pid}/gifts/{id} {
        allow read, write: if member(hid) && myPerson(hid) != pid;
      }

      match /members/{uid} {
        allow read: if member(hid);
        // You may add only yourself: as the household's creator (in the same batch that creates it),
        // or with a live invite to this household, as the person the invite was made for.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.personId is string && request.resource.data.personId.size() > 0 && (
          // creating the household: only in the same write that creates it (not by leaving and coming back)
          (!exists(/databases/$(database)/documents/households/$(hid))
            && getAfter(/databases/$(database)/documents/households/$(hid)).data.createdBy == uid)
          // joining: someone else's live invite, as its person, used up in this same write
          || (request.resource.data.invite is string
              && invite(request.resource.data.invite).hid == hid
              && invite(request.resource.data.invite).personId == request.resource.data.personId
              && invite(request.resource.data.invite).createdBy != uid
              && invite(request.resource.data.invite).expires > request.time
              && !existsAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite))));
        // who you are never changes (or you could become someone else and read their surprises)
        allow update: if member(hid) && request.resource.data.personId == resource.data.personId;
        allow delete: if request.auth.uid == uid || member(hid);   // leave, or remove someone
      }
    }

    // Invites are read one at a time by their code; they can't be listed.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if member(request.resource.data.hid) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expires is timestamp && code.size() >= 20
        && request.resource.data.personId is string && request.resource.data.personId.size() > 0;
      // members can cancel invites; the person joining deletes it as part of joining
      allow delete: if signedIn() && existsAfter(/databases/$(database)/documents/households/$(resource.data.hid)/members/$(request.auth.uid));
      allow update: if false;
    }

    // Phase 0 sign-in test page: each person's own test area only.
    match /spike/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
